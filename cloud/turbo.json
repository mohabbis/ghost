{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "REDIS_URL",
    "AUTH_SECRET",
    "AUTH_URL",
    "NEXTAUTH_URL",
    "AUTH_GITHUB_ID",
    "AUTH_GITHUB_SECRET",
    "S3_ENDPOINT",
    "S3_REGION",
    "S3_BUCKET",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY",
    "GHOST_SESSION_KEY",
    "GHOST_MFA_KEY",
    "HR_API_KEY",
    "GHOST_STEP_TIMEOUT_MS",
    "GHOST_RUN_TIMEOUT_MS",
    "GHOST_ALLOW_SKIP_DB_TESTS",
    "WORKER_CONCURRENCY",
    "APP_URL",
    "NODE_ENV",
    "GHOST_ACCESS_TOKEN",
    "GHOST_API_URL",
    "GHOST_CAPTURE_KEY",
    "GHOST_CAPTURE_PORT",
    "GHOST_CAPTURE_MAX_SESSIONS",
    "NEXT_PUBLIC_GHOST_CAPTURE_URL"
  ],
  "globalPassThroughEnv": [
    "PLAYWRIGHT_BROWSERS_PATH",
    "PLAYWRIGHT_CHROMIUM_EXECUTABLE",
    "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD",
    "GHOST_ARTIFACT_DIR"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    }
  }
}
