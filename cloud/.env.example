# ---------------------------------------------------------------------------
# Ghost Cloud — local development environment
# Copy to `.env` (git-ignored) and fill in. docker-compose provides Postgres +
# Redis with the defaults below out of the box.
# ---------------------------------------------------------------------------

# Postgres (matches cloud/docker-compose.yml)
DATABASE_URL="postgresql://ghost:ghost@localhost:5432/ghost?schema=public"

# Redis / BullMQ (matches cloud/docker-compose.yml)
REDIS_URL="redis://localhost:6379"

# Auth.js v5
# Generate with: npx auth secret   (or: openssl rand -base64 32)
#
# The value below is a dev-only throwaway so `cp .env.example .env` yields a
# working stack, exactly like GHOST_SESSION_KEY further down. Because it lives
# in this repository it is public: anyone holding it can forge a session for
# any user in any organization. Production therefore REFUSES TO START on it,
# on an unset value, or on anything shorter than 32 characters — see
# apps/web/src/lib/auth-env.ts. (Compiling is exempt; `next build` needs no
# secret.)
AUTH_SECRET="dev-only-change-me-openssl-rand-base64-32"

# Also used as a safety signal: the passwordless "Dev sign-in (any email)"
# provider is registered only when NODE_ENV is not production AND this URL is
# loopback AND GHOST_DISABLE_DEV_SIGNIN is not "true". A deployed instance
# therefore never exposes it, even with NODE_ENV unset.
AUTH_URL="http://localhost:3000"

# Belt-and-braces off switch for the dev sign-in provider.
# GHOST_DISABLE_DEV_SIGNIN="true"

# Session lifetime. Defaults to 12h; Auth.js's own default is 30 days, which is
# a long time for a product that can move money in the systems it operates.
# GHOST_SESSION_MAX_AGE_SECONDS="43200"

# GitHub OAuth (optional in dev — the "dev credentials" provider works without it).
# Create an OAuth app: https://github.com/settings/developers
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Google OAuth (also optional in dev, same reason). Offer either, both, or
# neither — each is registered independently based on which vars are set.
# Create an OAuth client: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email magic-link sign-in via Resend (optional in dev, same reason). Needs
# the sending domain verified in Resend (SPF/DKIM DNS records) before real
# emails will deliver — see docs/DEPLOY.md. Setting this also activates the
# Prisma adapter (see auth.ts), which GitHub/Google reuse for account linking.
# Install: https://vercel.com/marketplace/resend, or https://resend.com directly.
RESEND_API_KEY=""
RESEND_EMAIL_DOMAIN=""

# S3-compatible object storage for run screenshots + recording traces.
# Works with AWS S3, Cloudflare R2, or MinIO. Not required for local dev.
#
# REQUIRED once web and worker run on separate hosts, and on BOTH of them: with
# no shared filesystem each falls back to its own local disk, so the worker
# writes screenshots the web app cannot read. Every image 404s and the person at
# an approval gate is deciding with no evidence. See docs/DEPLOY.md.
# The bucket name below is inert until the two keys are also set.
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET="ghost-artifacts"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Local disk artifact store (used when S3 is not configured). The worker WRITES
# run screenshots here and the web app SERVES them, so both processes must point
# at the SAME absolute path. Set it to an absolute dir, e.g. <repo>/cloud/.artifacts
GHOST_ARTIFACT_DIR=""

# Base URL the worker uses to reach app-served pages (the demo fixture).
APP_URL="http://localhost:3000"

# Where THIS instance's source lives. Ghost is AGPL-3.0-or-later, and section 13
# obliges anyone running a *modified* Ghost as a network service to offer its
# users the source of the version they are talking to. The app links this from
# the sidebar and the sign-in page. Leave unset to point at upstream; set it to
# your own published source (ideally a specific tag or commit) if you run a fork.
# NEXT_PUBLIC_SOURCE_URL="https://github.com/you/your-ghost-fork/tree/v1.2.3"

# ---------------------------------------------------------------------------
# Session encryption (WORKER ONLY — do not set this for the web app)
# ---------------------------------------------------------------------------
# When a run halts at an approval gate the worker captures the browser's
# storageState so the resumed run can rebuild the page without replaying any
# action. That blob contains live session cookies for the customer's systems,
# so it is sealed with AES-256-GCM before it touches the artifact store.
#
# Keep this out of the web app's environment: the web app never needs to
# decrypt a session blob, so withholding the key means a web-side vulnerability
# with disk or bucket read access still cannot read one.
#
# Generate with: openssl rand -base64 32   (must decode to exactly 32 bytes)
#
# Leaving this empty does NOT degrade gracefully, despite only being needed at a
# gate. With no key the worker skips session capture, `Run.sessionUrl` stays
# null, and on resume `planRestore` returns `unsafe` — so every approved run
# ends INCIDENT instead of SUCCEEDED. Refusing to replay unverifiable actions is
# the correct production behaviour, but it also means an empty value here breaks
# the one flow Ghost exists to demonstrate, and breaks 16 tests in the worker
# suite that assert a run completes.
#
# The value below is a dev-only throwaway so `cp .env.example .env` yields a
# working stack. Replace it in any environment that touches real systems.
GHOST_SESSION_KEY="Z2hvc3QtZGV2LW9ubHkta2V5LW5vdC1hLXNlY3JldCE="

# Default per-step wall-clock budget in ms (a step may override it). Default 30s.
GHOST_STEP_TIMEOUT_MS="30000"

# How many runs one worker process executes at once. Each holds a browser, so
# this is memory-bound. Default 2.
WORKER_CONCURRENCY="2"

# ---------------------------------------------------------------------------
# Agent plugin / MCP (optional — local dogfood)
# Agents may list/preview/start runs; they cannot approve. Sign in and create a
# revocable credential in Settings. This value is used only by the MCP process,
# not by the web app.
# ---------------------------------------------------------------------------
# GHOST_ACCESS_TOKEN="ghost_agent_…"
# MCP bridge only (apps/mcp) — where Ghost listens:
# GHOST_API_URL="http://localhost:3000"

# HarnessRouter — DEVELOPMENT / SELF-HOST ONLY. Not a production runtime
# dependency and not "runtime agent execution": nothing Ghost executes for a
# customer goes through it. It backs one optional authoring convenience,
# recording compile (raw trace -> proposed steps), which is off unless this key
# is set. Ghost boots, replays workflows, gates, verifies and audits with this
# variable absent.
#
# Leave it blank in production. A trace is customer data — request and response
# bodies, headers, typed input — and setting this key sends it whole to a third
# party. See docs/DEPLOY.md.
HR_API_KEY=

# ---------------------------------------------------------------------------
# Two-factor authentication (web app)
# ---------------------------------------------------------------------------
# Encrypts stored TOTP secrets (AES-256-GCM, see packages/core/src/crypto/mfa-secret.ts).
# Separate from GHOST_SESSION_KEY on purpose: that one is worker-only so a
# web-side vulnerability cannot decrypt a captured browser session, and the web
# app must decrypt TOTP secrets on every sign-in.
#
# Unset means two-factor is unavailable — Ghost refuses to store the secrets in
# the clear rather than silently downgrading.
#
# Generate with: openssl rand -base64 32   (must decode to exactly 32 bytes)
GHOST_MFA_KEY=""
