// Ghost Cloud data model.
// Trust pipeline: Workflow -> Version (immutable steps) -> Run -> RunStep,
// with Approval gates on sensitive steps and an append-only hash-chained
// AuditEvent log. Auth.js owns User/Account/Session; everything else is scoped
// to an Organization for multi-tenant B2B.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth) — standard adapter models.
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  // Two-factor. `mfaSecret` is an AES-256-GCM envelope (see
  // crypto/mfa-secret.ts), never the raw TOTP secret. `mfaEnabledAt` is the
  // authority on whether 2FA is *active*: a secret exists from the moment
  // enrolment starts, and treating its presence as "enabled" would lock a
  // user out the instant they opened the enrolment screen and walked away.
  mfaSecret    String?
  mfaEnabledAt DateTime?

  accounts            Account[]
  sessions            Session[]
  mfaRecoveryCodes    MfaRecoveryCode[]
  memberships         Membership[]
  createdFlows        Workflow[]        @relation("WorkflowCreatedBy")
  triggeredRuns       Run[]             @relation("RunTriggeredBy")
  assignedIncidents   Run[]             @relation("RunIncidentAssignee")
  resolvedApprovals   Approval[]        @relation("ApprovalResolvedBy")
  agentCredentials    AgentCredential[]
  invitationsSent     Invitation[]      @relation("InvitationCreatedBy")
  invitationsAccepted Invitation[]      @relation("InvitationAcceptedBy")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

enum Role {
  OWNER
  ADMIN
  MEMBER
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  // Expected tail of the org-wide append-only AuditEvent chain, mirroring
  // Run.journalHead. appendAuditEvent updates this in the same transaction as
  // every event, so deleting a valid suffix of AuditEvent (without also
  // rewriting this column) is detected instead of silently verifying as an
  // intact, merely shorter, chain. See docs/CURSOR_HANDOFF.md "Known gaps in
  // compensation (undo)" for what this does and does not defend against — an
  // attacker able to rewrite both AuditEvent and this column stays out of
  // scope; that requires an anchor genuinely outside this database.
  auditChainHead String?

  memberships      Membership[]
  invitations      Invitation[]
  workflows        Workflow[]
  recordings       Recording[]
  runs             Run[]
  auditEvents      AuditEvent[]
  connectors       Connector[]
  agentCredentials AgentCredential[]
}

// Revocable credentials created by an authenticated Ghost user for agent/MCP
// clients. Only a SHA-256 digest is persisted; the plaintext is shown once.
model AgentCredential {
  id         String    @id @default(cuid())
  orgId      String
  userId     String
  name       String
  tokenHash  String    @unique
  tokenHint  String
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([userId])
}

// An invitation to join an organization.
//
// Only a SHA-256 digest of the token is stored, the same as AgentCredential —
// the plaintext link is shown to the inviter once and is unrecoverable after.
// A leaked link is still bounded: acceptance requires the signed-in user's
// email to match the invited address, so holding the token is not by itself
// enough to join an organization.
model Invitation {
  id        String   @id @default(cuid())
  orgId     String
  // Normalized to lowercase on write; acceptance compares against the
  // signed-in user's email, so casing must not decide who may join.
  email     String
  role      Role     @default(MEMBER)
  tokenHash String   @unique
  expiresAt DateTime

  createdById  String?
  acceptedAt   DateTime?
  acceptedById String?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy  User?        @relation("InvitationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  acceptedBy User?        @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([email])
}

// Single-use recovery codes for when an authenticator is lost.
//
// Digest-only, like every other credential here. Rows are kept after use
// rather than deleted so "this code was already used" stays distinguishable
// from "this code never existed" for the person reading an audit log.
model MfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  orgId     String
  // Defaults to OWNER because the first membership in an org is created by
  // `ensureUserOrg` for whoever brought the org into existence. Invited
  // members are always created with an explicit role from their invitation —
  // never this default.
  role      Role     @default(OWNER)
  createdAt DateTime @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
}

// ---------------------------------------------------------------------------
// Workflows
// ---------------------------------------------------------------------------

model Workflow {
  id                      String   @id @default(cuid())
  orgId                   String
  name                    String
  description             String?
  archived                Boolean  @default(false)
  // Airflow's `max_active_runs`: at most this many runs of this workflow may be
  // in flight at once; the rest wait in QUEUED. Null means no cap. Per workflow
  // rather than per version, so publishing v4 does not double the load the
  // workflow is allowed to put on the system it operates. See
  // packages/core/src/runtime/concurrency.ts for which statuses hold a slot.
  maxActiveRuns           Int?
  // Separation of duties: when true, whoever triggered a run may not approve its
  // gates. Someone else in the organization must.
  //
  // Opt-in, and it has to be. `ensureUserOrg` creates a single-member
  // organization on first sign-in and there is no invite flow, so most orgs
  // contain exactly one human — defaulting this on would mean nobody could ever
  // approve anything and every run would deadlock at its first gate.
  //
  // Restricts approval only. Rejection is never restricted: it stops the action,
  // and the person who started a runaway run must be able to halt it.
  requireSeparateApprover Boolean  @default(false)
  createdById             String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  org        Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy  User?             @relation("WorkflowCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  versions   WorkflowVersion[]
  recordings Recording[]

  @@index([orgId])
}

// Immutable snapshot of a workflow's steps. Runs always target a version, so
// editing a workflow never mutates the definition a past run executed.
model WorkflowVersion {
  id         String   @id @default(cuid())
  workflowId String
  version    Int
  // Array of steps validated by packages/core/src/schema/step.ts (Zod).
  steps      Json
  note       String?
  createdAt  DateTime @default(now())

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  runs     Run[]

  @@unique([workflowId, version])
  @@index([workflowId])
}

// ---------------------------------------------------------------------------
// Recording (Phase 2) — captured events compiled into a WorkflowVersion.
// ---------------------------------------------------------------------------

enum RecordingStatus {
  ACTIVE
  STOPPED
  COMPILED
  DISCARDED
}

// Convert half of Phase 2 (`docs/CURSOR_HANDOFF.md`): turning one uploaded
// trace into a proposed `WorkflowStep[]` via a HarnessRouter runtime agent.
// Separate from `RecordingStatus`, which tracks the *capture* lifecycle —
// a STOPPED recording can be recompiled after a FAILED attempt without
// pretending the capture itself needs to happen again.
enum RecordingCompileStatus {
  NONE
  RUNNING
  READY
  FAILED
}

model Recording {
  id               String          @id @default(cuid())
  orgId            String
  status           RecordingStatus @default(ACTIVE)
  // S3 key of the raw captured event trace.
  rawTraceKey      String?
  rawTraceFilename String?
  sessionMeta      Json?

  // Handle for an in-flight compile, opaque to Ghost. `compileSessionId` is
  // the recovery identifier used to resume polling after a dropped connection
  // (never start a second task on top of one already running — see
  // apps/web/src/lib/recording-compiler.ts).
  //
  // Deliberately named after the *role* rather than the implementation. These
  // columns previously carried a vendor's vocabulary, which put a replaceable
  // authoring tool into the core data model and made it read as though
  // customer workflows executed through it. The compiler behind them is
  // chosen at runtime and may be absent entirely — see lib/compiler/.
  compileStatus    RecordingCompileStatus @default(NONE)
  compileJobId     String?
  compileSessionId String?
  // Proposed steps, validated against `@ghost/core/schema/step` before
  // storage. A *proposal* a human reviews in the editor — never executed
  // directly, never trusted the way a published WorkflowVersion is.
  compiledSteps     Json?
  compileNotes      String?
  compileError      String?

  // Set once a human reviews the proposal and actually publishes it.
  workflowId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  workflow Workflow?    @relation(fields: [workflowId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([workflowId])
}

// ---------------------------------------------------------------------------
// Runs
// ---------------------------------------------------------------------------

enum RunStatus {
  QUEUED
  RUNNING
  AWAITING_APPROVAL
  SUCCEEDED
  FAILED
  CANCELED
  // A step failed or could not be safely resumed and a human must decide:
  // retry, skip, or cancel. Borrowed from Camunda incidents — a broken step
  // should not silently kill a 40-invoice batch.
  INCIDENT
  // Reversing the run's completed side effects (BPMN compensation).
  COMPENSATING
  // Reversal finished. Not the same as SUCCEEDED, and not the same as never
  // having run — the run happened and was then walked back.
  COMPENSATED
}

enum StepStatus {
  PENDING
  RUNNING
  AWAITING_APPROVAL
  SUCCEEDED
  FAILED
  SKIPPED
  // The step ran, and its effect was later reversed by a compensation. Not the
  // same as SKIPPED: writing SKIPPED over a reversed step made the timeline
  // claim the original action never happened, when it happened and is precisely
  // why there was something to undo.
  COMPENSATED
  // The step started, the worker died, and the step's effect is at-most-once
  // (a payment, a send). We cannot know whether it landed. Re-running risks a
  // double-submit; skipping risks a silent no-op. Neither is ours to choose —
  // the run stops and a human decides.
  UNKNOWN
}

model Run {
  id                String    @id @default(cuid())
  orgId             String
  workflowVersionId String
  status            RunStatus @default(QUEUED)
  triggeredById     String?
  // Denormalized cache of the next step index, for list views only.
  //
  // NOT the source of truth for control flow. Execution position is derived by
  // folding the RunEvent journal (see apps/worker/src/runtime/journal.ts): a
  // stale cursor must never be able to cause a completed step to re-execute.
  // Written inside the same transaction that commits a step.
  cursor            Int       @default(0)
  error             String?
  startedAt         DateTime?
  endedAt           DateTime?
  createdAt         DateTime  @default(now())

  // Cooperative lease: one worker owns a run at a time. Blocks the concurrent
  // double-execution case; the journal blocks the sequential-after-crash case.
  leaseOwner     String?
  leaseExpiresAt DateTime?
  attempt        Int       @default(0)

  // When this run took a concurrency slot under its workflow's cap, or null if
  // it holds none. See packages/core/src/runtime/concurrency.ts.
  //
  // Explicit rather than derived from `status`, because status moves for
  // reasons that have nothing to do with whether the run is still touching the
  // customer's system: a cancel flips to CANCELED while the worker is
  // deliberately letting the current action finish, and an approved run passes
  // through QUEUED on its way back to RUNNING. Both windows let another run be
  // admitted alongside one that is still executing — which is the single thing
  // the cap exists to prevent. A slot is taken and given back, not inferred.
  slotHeldAt DateTime?

  // Artifact key of the ENCRYPTED storageState captured at the last halt, plus
  // the page URL it was captured on. Restoring these is how a resumed run
  // rebuilds browser state without re-executing any prior side effect.
  sessionKey String?
  sessionUrl String?

  // Expected tail of the append-only journal. appendRunEvent updates this in
  // the same transaction as every event, so deleting a valid suffix cannot
  // make an already-completed action reachable again.
  journalHead String?

  // Set once the retention job has deleted this run's artifact prefix
  // (screenshots + any residual session blobs) from the store. Null means
  // either the run has not ended, or it has but is not old enough yet — see
  // packages/core/src/retention.ts. Distinct from `endedAt` being null: a run
  // can be long finished and still have this null while it waits out the
  // retention window.
  artifactsPurgedAt DateTime?

  // Exception routing. Both are denormalized caches for the queue view, in the
  // same sense as `cursor`: written in the same transaction that raises the
  // incident, never the source of truth for a control-flow decision.
  //
  // `incidentKind` is the deterministic classifier's verdict
  // (packages/core/src/classifier/exception.ts) recorded at the moment the run
  // stopped, so the queue filters and sorts in SQL instead of re-classifying
  // every row on read. Stored rather than derived because the reason string it
  // was computed from can be superseded by a later failure on the same run, and
  // "what did Ghost think this was when it stopped?" deserves the answer from
  // that moment.
  //
  // Both are cleared when the run leaves INCIDENT — a resolved exception must
  // not linger in the queue, nor stay assigned to whoever finished with it.
  incidentKind       String?
  incidentAssigneeId String?

  // When this run entered INCIDENT.
  //
  // The queue orders by this, NOT by `createdAt`: those differ, and the
  // difference is the whole point of the ordering. A run created a week ago that
  // fails in the last minute has been *parked* for a minute, and sorting it
  // ahead of yesterday's stuck run — which is what `createdAt` does — buries
  // exactly the row that has been waiting. It is also what the UI's "stopped Nm
  // ago" reads, so an age of "6d" no longer means "this run is 6 days old."
  //
  // Rewritten on every fresh incident, including one raised by a failed
  // reversal, so an inherited timestamp cannot make new work look stale.
  incidentRaisedAt   DateTime?

  org             Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  workflowVersion WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  triggeredBy     User?           @relation("RunTriggeredBy", fields: [triggeredById], references: [id], onDelete: SetNull)
  // SetNull, not Cascade: removing a person from the org must never delete the
  // run they were looking at. The exception returns to unassigned.
  incidentAssignee User?          @relation("RunIncidentAssignee", fields: [incidentAssigneeId], references: [id], onDelete: SetNull)
  steps           RunStep[]
  approvals       Approval[]
  events          RunEvent[]

  @@index([orgId])
  @@index([workflowVersionId])
  @@index([status, leaseExpiresAt])
  // The exception queue's own query: this org's open incidents, longest-parked
  // first. Ordered on incidentRaisedAt, not createdAt — see that field.
  @@index([orgId, status, incidentRaisedAt])
  @@index([incidentAssigneeId])
  // Admission counts a workflow's in-flight runs on every start and resume.
  @@index([workflowVersionId, status])
  @@index([workflowVersionId, slotHeldAt])
  // The retention job's own query: ended runs it has not yet purged.
  @@index([endedAt, artifactsPurgedAt])
}

// ---------------------------------------------------------------------------
// Run journal — the durable-execution substrate.
//
// Append-only, hash-chained per run. This is what makes resumption safe: a step
// with a recorded terminal success is never re-executed, so a crash mid-run
// cannot re-fire an already-approved payment. Chained per RUN rather than per
// org so concurrent runs never contend on one chain tail (the org-wide chain in
// AuditEvent anchors each run's head hash at run boundaries as an independent,
// customer-visible seal. Run.journalHead protects resumptions between those
// boundaries from a truncated suffix.
//
// Payloads never carry secrets: no fill values, no storageState, no cookies.
// ---------------------------------------------------------------------------

model RunEvent {
  id String @id @default(cuid())

  runId     String
  /// Monotonic per run, starting at 1. The ordering key — never order by createdAt.
  seq       Int
  /// Step index this event concerns; null for run-level events.
  stepIndex Int?
  /// See RUN_EVENT_TYPES in packages/core/src/runEvents.ts.
  type      String
  payload   Json?

  prevHash  String?
  hash      String
  createdAt DateTime @default(now())

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, seq])
  @@index([runId, seq])
}

model RunStep {
  id            String     @id @default(cuid())
  runId         String
  index         Int
  type          String
  status        StepStatus @default(PENDING)
  // Human-readable label copied from the step definition.
  label         String?
  // S3 key of the screenshot captured after this step.
  screenshotKey String?
  // Result of the step's verification assertion, if any.
  verification  Json?
  logs          Json?
  error         String?
  // Attempts made for this step, including retries. 0 until first execution.
  attempt       Int        @default(0)
  // Named values this step produced (an `extract` step's capture), readable by
  // later steps through the expression resolver. Redacted for sensitive sources.
  output        Json?
  startedAt     DateTime?
  endedAt       DateTime?

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, index])
  @@index([runId])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// Which direction of the run an approval belongs to. Without this, reversing a
// step would collide with the forward gate on the same (runId, stepIndex).
enum ApprovalPhase {
  FORWARD
  COMPENSATION
}

model Approval {
  id           String         @id @default(cuid())
  runId        String
  stepIndex    Int
  phase        ApprovalPhase  @default(FORWARD)
  status       ApprovalStatus @default(PENDING)
  reason       String
  resolvedById String?
  requestedAt  DateTime       @default(now())
  resolvedAt   DateTime?
  note         String?
  // After this instant the approval can no longer be consumed and the run
  // raises an incident instead. Stops an approve clicked and forgotten from
  // firing a payment days later.
  expiresAt    DateTime?

  run        Run   @relation(fields: [runId], references: [id], onDelete: Cascade)
  resolvedBy User? @relation("ApprovalResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  // One approval per gated step per phase. Without the uniqueness, two
  // concurrent workers each create a PENDING row and resolving one leaves the
  // other pending forever; without the phase, undoing a step would collide with
  // the forward approval for that same step.
  @@unique([runId, stepIndex, phase])
  @@index([runId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Audit — append-only, hash-chained per organization.
// ---------------------------------------------------------------------------

model AuditEvent {
  id         String   @id @default(cuid())
  orgId      String
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  // Monotonic per org, starting at 1. Ordering key for the chain — createdAt is
  // a TIMESTAMP(3) and can tie, which would make verification order ambiguous.
  // The unique constraint also turns a lost append race into a retryable
  // constraint violation rather than a silently forked chain.
  seq        Int
  // Hash chain: hash = sha256(prevHash + canonical(payload)).
  prevHash   String?
  hash       String
  createdAt  DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, seq])
  @@index([orgId, seq])
  @@index([orgId, createdAt])
}

// ---------------------------------------------------------------------------
// Connectors (post-MVP) — scoped, encrypted credentials for API integrations.
// Schema is present so the trust model is designed in from the start; no UI or
// command reads these yet.
// ---------------------------------------------------------------------------

enum ConnectorKind {
  GMAIL
  OUTLOOK
  SALESFORCE
  HUBSPOT
  QUICKBOOKS
  NETSUITE
  GOOGLE_DRIVE
  DROPBOX
  CUSTOM
}

model Connector {
  id        String        @id @default(cuid())
  orgId     String
  kind      ConnectorKind
  label     String
  // Encrypted at rest (envelope encryption); never a raw secret in the row.
  secretRef String?
  scopes    String[]
  createdAt DateTime      @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}
