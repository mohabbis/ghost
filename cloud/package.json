{
  "name": "ghost-cloud",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "Ghost Cloud \u2014 AI operator that learns business workflows and executes them across existing software (record \u2192 review \u2192 approve \u2192 replay \u2192 verify \u2192 audit).",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "demo": "bash scripts/demo.sh",
    "check": "bash scripts/doctor.sh",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "prisma generate --schema packages/core/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema packages/core/prisma/schema.prisma",
    "db:validate": "prisma validate --schema packages/core/prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema packages/core/prisma/schema.prisma"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "prisma": "^6.1.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
