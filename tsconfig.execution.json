{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "outDir": "src/execution",
    "rootDir": "src/execution",
    "declaration": false,
    "noEmitOnError": true
  },
  "include": ["src/execution/*.ts"],
  "exclude": ["src/execution/*.js"]
}
