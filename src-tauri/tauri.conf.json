{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ghost",
  "version": "2.0.3",
  "identifier": "com.muhammadrafiq.ghost",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Ghost",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Safe, reusable, permission-bounded computer routines.",
    "longDescription": "Ghost turns repeated computer work into safe, reusable, permission-bounded routines: record, inspect, approve, replay, audit, undo.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "Ghost.entitlements"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/mohabbis/ghost/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhENTBCOEYwODg4RkY0MgpSV1JDLzRnSWp3dlZDQlBucE1VRmZycUYvVllFQUMycGlNVXRWWmRRNHVHQ21OQkNiYS9qTFQ0OAo="
    }
  }
}
